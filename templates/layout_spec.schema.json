{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image-to-Visio layout spec",
  "type": "object",
  "required": ["canvas", "objects"],
  "properties": {
    "canvas": {
      "type": "object",
      "required": ["width_px", "height_px", "dpi"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "dpi": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "bbox_px"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["text", "rect", "roundrect", "line", "arrow", "ellipse", "image", "group"]},
          "bbox_px": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {"type": "number"},
            "description": "[x, y, width, height] in source-image top-left pixel coordinates"
          },
          "text": {"type": "string"},
          "style": {"type": "object"}
        }
      }
    }
  }
}
